# Railway PostgreSQL service -> DATABASE_URL (private internal URL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/simplecrm?schema=public"
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_TRUST_HOST="true"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"
# Only required for the one-time admin seed command. Do not commit real values.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="use-a-unique-long-random-password"
ADMIN_NAME="Administrator"
